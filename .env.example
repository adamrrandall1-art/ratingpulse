# ==============================================================================
# RatingPulse.co - Environment Variables Template
# Copy this file to .env.local and fill in your actual API keys
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Site URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Supabase Database & Auth Configuration
# Get these from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. Stripe Subscription Configuration ($25/Month with 14-Day Free Trial)
# Get these from: Stripe Dashboard -> Developers -> API keys & Webhooks
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_51...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_GROWTH_PRICE_ID=price_...

# ------------------------------------------------------------------------------
# 4. Google Gemini AI (Powering 1-Tap SEO Reply Generation)
# Get this from: Google AI Studio (https://aistudio.google.com/)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 5. Google Places & Business Profile API
# Get these from: Google Cloud Console -> APIs & Services -> Credentials
# ------------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=AIzaSy...
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ------------------------------------------------------------------------------
# 6. Twilio / SMS Delivery Provider (Optional for Live Production SMS)
# Get these from: Twilio Console (https://console.twilio.com/)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567

# ------------------------------------------------------------------------------
# 7. Resend Email Delivery Provider (Transactional & Notification Emails)
# Get this from: Resend Dashboard (https://resend.com/api-keys)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=notifications@ratingpulse.co
