datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Business {
  id                        String   @id @default(uuid())
  userId                    String?  @unique
  clerkUserId               String?
  name                      String
  category                  String?
  address                   String?
  phone                     String?
  email                     String?
  placeId                   String?
  reviewUrl                 String?
  googleReviewUrl           String?
  rating                    Float?   @default(0.0)
  reviewCount               Int?     @default(0)
  isGoogleConnected         Boolean  @default(false)

  // Notification routing fields
  negativeAlertEmail        String?
  negativeAlertPhone        String?
  positiveAlertEmail        String?
  positiveAlertPhone        String?
  negativeAlertsEnabled     Boolean  @default(true)
  negativeEmailAlertEnabled Boolean  @default(true)
  negativeSmsAlertEnabled   Boolean  @default(true)
  positiveAlertsEnabled     Boolean  @default(true)
  positiveEmailAlertEnabled Boolean  @default(true)
  positiveSmsAlertEnabled   Boolean  @default(false)
  negativeAlertSmsEnabled   Boolean  @default(true)
  smsAlertsEnabled          Boolean  @default(true)
  negativeAlertEmailEnabled Boolean  @default(true)
  positiveAlertSmsEnabled   Boolean  @default(false)
  positiveAlertEmailEnabled Boolean  @default(true)

  // AI Persona & Replies
  brandVoice                String?  @default("Professional & Warm")
  aiTone                    String?  @default("Professional & Warm")
  aiPersonality             String?  @default("Professional & Warm")
  aiInstructions            String?  @db.Text
  aiSignature               String?
  autoReplyEnabled          Boolean  @default(false)
  autoPublish5Star          Boolean? @default(false)
  customKeywords            String?
  seoKeywords               String?
  selectedModel             String?  @default("gemini-1.5-flash")
  smsTemplate               String?

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model BusinessSettings {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  googleReviewUrl       String?  @map("google_review_url")
  placeId               String?  @map("place_id")
  businessName          String?  @map("business_name")
  brandVoice            String?  @default("friendly_professional") @map("brand_voice")
  notifyNegativePhone   String?  @map("notify_negative_phone")
  notifyNegativeEmail   String?  @map("notify_negative_email")
  notifyNegativeEnabled Boolean  @default(true) @map("notify_negative_enabled")
  emailAlertsEnabled    Boolean  @default(true) @map("email_alerts_enabled")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("business_settings")
}

model Profile {
  id                    String    @id @default(uuid()) @db.Uuid
  clerkUserId           String?   @unique @map("clerk_user_id")
  fullName              String?   @map("full_name")
  businessName          String?   @default("") @map("business_name")
  businessCategory      String?   @default("") @map("business_category")
  phone                 String?
  notificationEmail     String?   @map("notification_email")
  notificationPhone     String?   @map("notification_phone")
  notifyPositivePhone   String?   @map("notify_positive_phone")
  notifyPositiveSms     Boolean?  @default(false) @map("notify_positive_sms")
  createdAt             DateTime? @default(now()) @map("created_at")
  updatedAt             DateTime? @updatedAt @map("updated_at")

  @@map("profiles")
}

