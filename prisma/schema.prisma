datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Business {
  id                        String   @id @default(uuid())
  userId                    String?  @unique
  clerkUserId               String?
  name                      String
  category                  String?
  address                   String?
  phone                     String?
  email                     String?
  placeId                   String?
  reviewUrl                 String?
  googleReviewUrl           String?
  rating                    Float?   @default(0.0)
  reviewCount               Int?     @default(0)
  isGoogleConnected         Boolean  @default(false)

  // Notification routing fields
  negativeAlertEmail        String?
  negativeAlertPhone        String?
  positiveAlertEmail        String?
  positiveAlertPhone        String?
  negativeAlertsEnabled     Boolean  @default(true)
  negativeEmailAlertEnabled Boolean  @default(true)
  negativeSmsAlertEnabled   Boolean  @default(true)
  positiveAlertsEnabled     Boolean  @default(true)
  positiveEmailAlertEnabled Boolean  @default(true)
  positiveSmsAlertEnabled   Boolean  @default(false)
  negativeAlertSmsEnabled   Boolean  @default(true)
  smsAlertsEnabled          Boolean  @default(true)
  negativeAlertEmailEnabled Boolean  @default(true)
  positiveAlertSmsEnabled   Boolean  @default(false)
  positiveAlertEmailEnabled Boolean  @default(true)

  // AI Persona & Replies
  brandVoice                String?  @default("friendly_professional")
  aiTone                    String?  @default("friendly_professional")
  aiInstructions            String?
  aiSignature               String?
  autoReplyEnabled          Boolean? @default(false)
  autoPublish5Star          Boolean? @default(false)
  customKeywords            String?
  selectedModel             String?  @default("gemini-3.8-flash")
  smsTemplate               String?

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}
